{
  "name": "glosa",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "build": "vite build && vite build --config vite.sweep.config.ts && node scripts/build-sw.mjs",
    "preview": "vite preview",
    "start": "srvx serve --prod --entry dist/server/server.js --static ../client --port 3000",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:e2e": "playwright test",
    "db:push": "supabase db push --linked --yes",
    "db:types": "supabase gen types --linked > src/server/database.types.ts",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/libre-caslon-text": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@sentry/node": "^11.8.0",
    "@sentry/react": "^11.8.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-start": "^1.169.2",
    "@zip.js/zip.js": "^2.23.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dexie": "^4.4.6",
    "foliate-js": "https://codeload.github.com/johnfactotum/foliate-js/tar.gz/78914aef4466eb960965702401634c2cb348e9b1",
    "lucide-react": "^1.57.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.5",
    "srvx": "^1.0.6",
    "tailwindcss": "^4",
    "three": "0.160.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.160.0",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "sharp": "^0.35.5",
    "supabase": "^2.121.0",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.5"
  }
}
